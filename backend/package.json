{
  "name": "college-nosql-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "REST API для учёта студентов колледжа на MongoDB (Express + Mongoose, чистый JavaScript)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:memory": "node scripts/dev-memory.js",
    "start": "node src/index.js",
    "db:fill": "node src/seed-fill.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.1",
    "nodemailer": "^7.0.9",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.2.2"
  }
}

# --- Сервер ---
PORT=5000
NODE_ENV=development

# --- MongoDB (нереляционная БД) ---
# Локальный mongod или MongoDB Atlas / Docker.
MONGO_URI=mongodb://127.0.0.1:27017/college_students
# Необязательно: имя БД, если оно не задано в URI.
MONGO_DB_NAME=

# --- Секреты (в production обязательны, минимум 32 символа) ---
JWT_SECRET=dev-secret-change-in-production
REFRESH_TOKEN_SECRET=refresh-secret-change-in-production
RESET_TOKEN_SECRET=reset-secret-change-in-production

# --- Пользователи, создаваемые при первом запуске ---
ADMIN_EMAIL=admin@college.local
ADMIN_PASSWORD=admin123
USER_EMAIL=user@college.local
USER_PASSWORD=user123
CURATOR_EMAIL=curator@college.local
CURATOR_PASSWORD=curator123
CURATOR_GROUP=ПО-507

# --- CORS и ссылки в письмах ---
CORS_ORIGIN=http://localhost:3000
FRONT_URL=http://localhost:3000

# --- SMTP (необязательно) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@college.local

# --- Аудит ---
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=2000
